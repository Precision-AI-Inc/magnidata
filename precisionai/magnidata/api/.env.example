# Copy to .env and fill in your values

# Override these if your data lives somewhere other than the defaults
# DATALAKE_ROOT=/mnt/disks/ssd-raid/datalake-clone
# THUMB_ROOT_64=/mnt/disks/ssd-raid/datalake-clone-thumbnails/64
# THUMB_ROOT_720=/mnt/disks/ssd-raid/datalake-clone-thumbnails/720

DB_PATH=./notes.db
API_PORT=5050

# MLflow tracking server (set by docker-compose; override when running the API on the host)
# MLFLOW_TRACKING_URI=http://localhost:5052
# MAGNIDATA_MLFLOW_UI_URL=http://localhost:5052
# MLFLOW_HTTP_REQUEST_TIMEOUT=10
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
