include LICENSE.md
include README.md
include README.pypi.md
include CHANGELOG.md
include SECURITY.md
include requirements.txt
include requirements-dev.txt
recursive-include precisionai *.py
# Non-.py runtime assets the Python package actually needs at import/run time —
# see [tool.setuptools.package-data] in pyproject.toml for the installed-wheel side
# of this (MANIFEST.in only controls the sdist).
include precisionai/magnidata/scripts/coco128_embeddings.json
include precisionai/magnidata/confi.yaml
include precisionai/magnidata/api/openapi.yaml
prune precisionai/magnidata/dashboard
# Packaged separately as magnidata-mcp; see mcp-server/pyproject.toml.
prune precisionai/magnidata/mcp_server
prune mcp-server
exclude precisionai/magnidata/api/.dockerignore
prune docs
prune deploy
prune .github
