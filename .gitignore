# Virtual environment (CONTRIBUTING.md: python -m venv .venv — never conda)
.venv/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]

# Distribution / packaging (setuptools-scm; release.yml runs `python -m build`)
build/
dist/
*.egg-info/

# Unit test / coverage reports (pytest, --cov-fail-under, genbadge[coverage])
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Sphinx documentation (docs/conf.py copies README.md -> docs/readme.md at build time)
docs/_build/
docs/readme.md

# PyCharm
.idea/

# VS Code
.vscode/

# PyTorch model artefacts (tools/embeddings.py via pyiqa/timm)
*.pth
*.pt
*.ckpt
*.onnx

# OS files
.DS_Store
Thumbs.db
*~

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# ── Secrets & environment ───────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# .env.example files are committed — they're templates, not secrets

# ── Dashboard (Node/Vite) ────────────────────────────────────────────────────────
node_modules/
.vite/

# ── Local database & runtime state ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
# User-created child datasets (docker-compose's only read-write mount for the API)
precisionai/dataviz/data_user/
# Provenance sidecars emitted next to tool outputs (features.py / embeddings.py)
*.provenance.json
# Locally staged image sets created by dataviz recipes/demo builds
/image_sets/*
!/image_sets/.gitkeep
