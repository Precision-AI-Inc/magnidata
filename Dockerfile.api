FROM python:3.12-slim

WORKDIR /app

COPY precisionai/magnidata/api/requirements.txt ./api-requirements.txt
RUN pip install --no-cache-dir -r api-requirements.txt

# tools/ and scripts/ are imported as precisionai.magnidata.tools / .scripts (see
# api/dataset_builder.py), so the package path is preserved rather than copied flat.
# Their only runtime deps (PIL, numpy) are already in api-requirements.txt above — the
# dataset-build pipeline never computes embeddings (bring your own), so the heavier
# precisionai/magnidata/requirements.txt (torch/timm/pyiqa, needed only by the offline
# tools/embeddings.py and tools/nima.py CLI paths) is intentionally not installed here.
COPY precisionai/__init__.py ./precisionai/__init__.py
COPY precisionai/magnidata/__init__.py ./precisionai/magnidata/__init__.py
COPY precisionai/magnidata/tools ./precisionai/magnidata/tools
COPY precisionai/magnidata/scripts ./precisionai/magnidata/scripts
# Torch- and mlflow-free: the shared training contract is imported by embeddings_io.
COPY precisionai/magnidata/training ./precisionai/magnidata/training

COPY precisionai/magnidata/api/app.py precisionai/magnidata/api/db.py \
     precisionai/magnidata/api/local_files.py precisionai/magnidata/api/dataset_builder.py \
     precisionai/magnidata/api/embeddings_io.py precisionai/magnidata/api/projections.py \
     precisionai/magnidata/api/mlflow_store.py precisionai/magnidata/api/experiments.py \
     precisionai/magnidata/api/artifact_cache.py precisionai/magnidata/api/run_axes.py \
     precisionai/magnidata/api/trainer_backend.py precisionai/magnidata/api/training_presets.py ./

EXPOSE 5050

CMD ["python", "app.py"]
