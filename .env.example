# Settings for `docker compose up`. Copy to .env (git-ignored) beside docker-compose.yml and uncomment what
# you change; Compose reads it on its own. Every value below is the default.

# Compose project name. Containers and volumes are named after it, so a second checkout on the same machine
# needs its own (and its own ports below) to run beside the first instead of replacing it.
# COMPOSE_PROJECT_NAME=magnidata

# Host ports for the portal, the API and the MLflow UI.
# MAGNIDATA_PORTAL_PORT=5175
# MAGNIDATA_API_PORT=5051
# MAGNIDATA_MLFLOW_PORT=5052

# Host address the ports are published on. Nothing in the stack has authentication, so the default lets only
# this machine in. 0.0.0.0 opens the stack to everyone who can reach this machine.
# MAGNIDATA_BIND_ADDRESS=127.0.0.1

# Host names MLflow answers to. Add the address you reach it by if you change MAGNIDATA_BIND_ADDRESS.
# MAGNIDATA_MLFLOW_ALLOWED_HOSTS=mlflow:5000,localhost:*,127.0.0.1:*

# Browser origins, other than the API's own, that may call the API (comma-separated). Empty means the portal
# (http://localhost:<MAGNIDATA_PORTAL_PORT>) and the dashboard's Vite dev server (http://localhost:5174).
# MAGNIDATA_CORS_ORIGINS=

# The user the api and trainer containers run as, so the files they write under data_user/ are yours.
# Empty means the owner of the checkout's data/ folder, which is normally you.
# MAGNIDATA_UID=
# MAGNIDATA_GID=

# Extra Compose files, e.g. the GPU trainer (docker-compose.gpu.yml) or AgriTune (docker-compose.agritune.yml).
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
